generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id            String   @id
  name          String
  price         Float
  priceUsd      Float?   @map("price_usd")
  stock         Int      @default(0)
  active        Boolean  @default(true)
  staffOnly     Boolean  @default(false) @map("staff-only")
  marketRegions String[] @default([]) @map("market-regions")

  @@map("Products")
}
